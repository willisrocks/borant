#!/usr/bin/env bash
# A stand-in `borant` for the chief mod's visual tests. It serves the board
# and task lists from files that a test changes, and follows events.jsonl as
# `borant events --follow --json` would. Put its folder first on PATH and set
# BORANT_STUB_DIR. Every call goes to calls.log with a timestamp.
dir="${BORANT_STUB_DIR:?set BORANT_STUB_DIR}"
echo "$(date +%s.%N) $*" >>"$dir/calls.log"
case "$1" in
  # A test stops the hub with board.fail, and the event stream with events.off.
  board) [ -e "$dir/board.fail" ] && { echo "hub unreachable" >&2; exit 1; }; cat "$dir/board.json" ;;
  tasks) cat "$dir/tasks-$2.json" 2>/dev/null || echo '[]' ;;
  events) [ -e "$dir/events.off" ] && exit 1; exec tail -n0 -F "$dir/events.jsonl" 2>/dev/null ;;
  hook) exit 0 ;;
  # The plugin's MCP server: task_close and send, for a Done's turn.
  mcp) exec node "$(dirname "$(realpath "$0")")/stub-mcp.mjs" ;;
  # The Ask button sends as the person; a test only records it.
  # send.slow makes a send take 3 s, as a slow hub does.
  send) [ -e "$dir/send.slow" ] && sleep 3; exit 0 ;;
  *) echo "borant-stub: $*" >&2; exit 2 ;;
esac
